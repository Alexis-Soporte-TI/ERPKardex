@model ERPKardex.Models.IngresoSalidaAlm
@{
    Layout = null;

    var empresa = ViewBag.Empresa as ERPKardex.Models.Empresa;
    var proveedor = ViewBag.Proveedor as ERPKardex.Models.Proveedor;
    var usuario = ViewBag.Usuario as ERPKardex.Models.Usuario;
    var detalles = ViewBag.Detalles as IEnumerable<dynamic>;

    var estado = ViewBag.Estado as string;
    var tituloImpresion = ViewBag.TituloImpresion as string;
    var almacen = ViewBag.Almacen as string;
    var sucursal = ViewBag.Sucursal as string;
    var motivo = ViewBag.Motivo as string;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>@Model.Numero</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">

    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            font-size: 11px;
            color: #000;
        }

        .box-border {
            border: 1px solid #000;
            border-radius: 5px;
            padding: 10px;
        }

        .table-bordered th, .table-bordered td {
            border: 1px solid #000 !important;
            padding: 4px;
            vertical-align: middle;
        }

        .bg-header {
            background-color: #eee;
            font-weight: bold;
        }

        @@media print {
            .no-print {
                display: none !important;
            }

            body {
                margin: 0;
                padding: 0;
            }

            .container {
                max-width: 100%;
                width: 100%;
            }

            .bg-header {
                background-color: #eee !important;
                -webkit-print-color-adjust: exact;
            }

            .box-border {
                border: 1px solid #000 !important;
            }
        }
    </style>
</head>
<body class="bg-white">

    <div class="container mt-3 mb-3 no-print text-right">
        <button onclick="window.print()" class="btn btn-primary"><i class="fas fa-print"></i> Imprimir</button>
        <button onclick="window.close()" class="btn btn-secondary"><i class="fas fa-times"></i> Cerrar</button>
    </div>

    <div class="container p-4">

        <div class="row mb-4 align-items-center">
            <div class="col-2 text-center">
                <i class="fas fa-boxes fa-4x text-secondary"></i>
            </div>
            <div class="col-6">
                <h4 class="font-weight-bold m-0">@empresa?.RazonSocial.ToUpper()</h4>
                <div class="font-weight-bold">RUC: @empresa?.Ruc</div>
                <div class="small">Sede: @sucursal</div>
            </div>
            <div class="col-4">
                <div class="box-border text-center bg-light">
                    <h6 class="font-weight-bold mb-1">@tituloImpresion</h6>
                    <h4 class="font-weight-bold text-danger m-0">@Model.Numero</h4>

                    <div class="mt-2 border-top border-secondary pt-1">
                        <small class="text-muted d-block">ESTADO ACTUAL</small>
                        <span class="font-weight-bold text-dark" style="font-size: 1.3em; letter-spacing: 1px;">
                            @estado?.ToUpper()
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <div class="row mb-2">
            <div class="col-12">
                <div class="box-border">
                    <div class="row">
                        <div class="col-7 border-right">
                            <h6 class="font-weight-bold text-decoration-underline mb-2">ENTIDAD / REFERENCIA</h6>
                            <div class="row">
                                <div class="col-3 font-weight-bold">ENTIDAD:</div>
                                <div class="col-9">@(proveedor != null ? proveedor.RazonSocial : "NO APLICA / USO INTERNO")</div>

                                <div class="col-3 font-weight-bold">N° DOC:</div>
                                <div class="col-9">@(proveedor != null ? proveedor.NumeroDocumento : "---")</div>

                                <div class="col-3 font-weight-bold">DOC. REF.:</div>
                                <div class="col-9">@(Model.SerieDocumento)-@(Model.NumeroDocumento)</div>
                            </div>
                        </div>

                        <div class="col-5">
                            <h6 class="font-weight-bold text-decoration-underline mb-2">DATOS DE ALMACÉN</h6>
                            <div class="row">
                                <div class="col-5 font-weight-bold">FECHA MOV.:</div>
                                <div class="col-7">@Model.Fecha?.ToString("dd/MM/yyyy")</div>

                                <div class="col-5 font-weight-bold">ALMACÉN:</div>
                                <div class="col-7">@almacen</div>

                                <div class="col-5 font-weight-bold">MOTIVO:</div>
                                <div class="col-7">@motivo</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <table class="table table-bordered table-sm mt-4">
            <thead class="bg-header text-center">
                <tr>
                    <th style="width: 5%">ITEM</th>
                    <th style="width: 15%">CÓDIGO</th>
                    <th style="width: 55%">DESCRIPCIÓN DEL PRODUCTO</th>
                    <th style="width: 10%">U.M.</th>
                    <th style="width: 15%">CANTIDAD</th>
                </tr>
            </thead>
            <tbody>
                @if (detalles != null)
                {
                    foreach (var item in detalles)
                    {
                        <tr>
                            <td class="text-center">@item.Item</td>
                            <td class="text-center">@item.CodProducto</td>
                            <td>@item.DescripcionProducto</td>
                            <td class="text-center">@item.CodUnidadMedida</td>
                            <td class="text-center font-weight-bold" style="font-size: 1.1em;">
                                @Convert.ToDecimal(item.Cantidad).ToString("N2")
                            </td>
                        </tr>
                    }
                }

                @* Relleno de filas en blanco si hay pocos productos para mantener formato *@
                @for (int i = 0; i < (12 - (detalles?.Count() ?? 0)); i++)
                {
                    <tr><td colspan="5" style="height: 25px;">&nbsp;</td></tr>
                }
            </tbody>
        </table>

        <div class="row mt-5 pt-5">
            <div class="col-4 text-center">
                <div class="border-top border-dark w-75 mx-auto pt-1">
                    <strong>ELABORADO POR</strong><br>
                    <span class="text-uppercase small">@usuario?.Nombre</span>
                </div>
            </div>

            <div class="col-4 text-center">
                <div class="border-top border-dark w-75 mx-auto pt-1">
                    <strong>Vº Bº ALMACÉN</strong><br>
                    <span class="text-uppercase small text-muted">Firma y Sello</span>
                </div>
            </div>

            <div class="col-4 text-center">
                <div class="border-top border-dark w-75 mx-auto pt-1">
                    <strong>@(Model.TipoMovimiento == true ? "ENTREGADO POR" : "RECIBIDO POR")</strong><br>
                    <span class="text-uppercase small text-muted">Nombre y Firma</span>
                </div>
            </div>
        </div>

        <div class="fixed-bottom text-center small text-muted mb-2 no-print">
            SYSSAF - Impreso el @DateTime.Now.ToString("dd/MM/yyyy HH:mm")
        </div>
    </div>

    <script>
        window.onload = function() {
            setTimeout(function(){ window.print(); }, 800);
        }
    </script>
</body>
</html>