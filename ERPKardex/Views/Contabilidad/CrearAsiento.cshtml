@{
    ViewData["Title"] = "Nuevo Asiento Contable";
}

<div class="card d-none" id="efec-cargando">
    <div class="position-fixed top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center overlay dark" style="z-index: 9999; background: rgba(0,0,0,0.5);">
        <i class="fas fa-3x fa-sync-alt fa-spin text-white"></i>
    </div>
</div>

<div class="container-fluid py-3">
    <div class="row justify-content-center">
        <div class="col-lg-12">

            <div class="card shadow mb-4 border-left-primary">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h5 class="m-0 font-weight-bold"><i class="fas fa-book"></i> Registro de Asiento Contable</h5>
                    <div>
                        <button class="btn btn-sm btn-info font-weight-bold shadow-sm mr-2" onclick="abrirModalVentas()">
                            <i class="fas fa-hand-holding-usd"></i> Jalar Venta (CxC)
                        </button>
                        <button class="btn btn-sm btn-warning font-weight-bold shadow-sm" onclick="abrirModalProvisiones()">
                            <i class="fas fa-shopping-cart"></i> Jalar Compra (CxP)
                        </button>
                    </div>
                </div>

                <div class="card-body">
                    <input type="hidden" id="hdn_EmpresaId" value="@ViewBag.EmpresaId" />

                    <div class="row mb-3">
                        <div class="col-md-4">
                            <label class="font-weight-bold text-dark">Origen (*)</label>
                            <select id="cbx_Origen" class="form-control select2-basic">
                                <option value="">-- Seleccione --</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="font-weight-bold text-dark">Fecha Contable (*)</label>
                            <input type="date" id="txt_FechaContable" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")">
                        </div>
                        <div class="col-md-4">
                            <label class="font-weight-bold text-dark">Moneda (*)</label>
                            <select id="cbx_Moneda" class="form-control select2-basic"></select>
                        </div>
                    </div>

                    <div class="row mb-2">
                        <div class="col-md-12">
                            <label class="font-weight-bold text-dark">Glosa / Concepto General (*)</label>
                            <input type="text" id="txt_Glosa" class="form-control" placeholder="Ej: Provisión de planilla de sueldos mes actual...">
                        </div>
                    </div>

                    <hr />

                    <div class="d-flex justify-content-between mb-2 mt-4">
                        <h6 class="font-weight-bold">Detalle del Asiento (Debe = Haber)</h6>
                        <button class="btn btn-sm btn-dark font-weight-bold" onclick="agregarLinea()"><i class="fas fa-plus"></i> Nueva Línea</button>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-bordered table-sm text-center mb-0" id="tbl_Asiento">
                            <thead class="thead-light">
                                <tr>
                                    <th width="35%" class="text-left">Cuenta Contable</th>
                                    <th width="30%">Glosa Detalle</th>
                                    <th width="15%">Debe</th>
                                    <th width="15%">Haber</th>
                                    <th width="5%">Acción</th>
                                </tr>
                            </thead>
                            <tbody id="tbl_Body">
                            </tbody>
                            <tfoot class="bg-light">
                                <tr>
                                    <th colspan="2" class="text-right align-middle">TOTALES:</th>
                                    <th><input type="text" id="txt_TotalDebe" class="form-control font-weight-bold text-right" readonly value="0.00"></th>
                                    <th><input type="text" id="txt_TotalHaber" class="form-control font-weight-bold text-right" readonly value="0.00"></th>
                                    <th id="lbl_Cuadre" class="align-middle text-success font-weight-bold"><i class="fas fa-check-circle"></i> OK</th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>

                    <div class="mt-4 text-right">
                        <button class="btn btn-secondary mr-2" onclick="location.reload()"><i class="fas fa-times"></i> Cancelar</button>
                        <button class="btn btn-primary font-weight-bold shadow-sm" onclick="guardarAsiento()"><i class="fas fa-save"></i> GUARDAR ASIENTO</button>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>

<div class="modal fade" id="modalProvisiones" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark py-2">
                <h6 class="modal-title font-weight-bold">Facturas de Compra sin Contabilizar</h6>
                <button type="button" class="close text-dark" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body p-0" style="max-height: 400px; overflow-y: auto;">
                <table class="table table-hover table-striped mb-0 text-center">
                    <thead class="thead-light">
                        <tr>
                            <th>Acción</th>
                            <th class="text-left">Proveedor</th>
                            <th>Documento</th>
                            <th>Fecha</th>
                            <th>Total</th>
                        </tr>
                    </thead>
                    <tbody id="tbodyProvisiones"></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalVentas" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-info text-white py-2">
                <h6 class="modal-title font-weight-bold">Facturas de Venta sin Contabilizar</h6>
                <button type="button" class="close text-white" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body p-0" style="max-height: 400px; overflow-y: auto;">
                <table class="table table-hover table-striped mb-0 text-center">
                    <thead class="thead-light">
                        <tr>
                            <th>Acción</th>
                            <th class="text-left">Cliente</th>
                            <th>Documento</th>
                            <th>Fecha</th>
                            <th>Total</th>
                        </tr>
                    </thead>
                    <tbody id="tbodyVentas"></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let CONTADOR_FILAS = 0;
        let CUENTAS_CACHE = []; // Para no pedir las cuentas en cada fila

        $(document).ready(function() {
            $('.select2-basic').select2({ theme: 'bootstrap4' });

            // Cargar datos de cabecera
            $.get('/Contabilidad/GetDatosCabecera', function(res) {
                    let htmlO = '<option value="">-- Seleccione --</option>';
                    res.origenes.forEach(x => htmlO += `<option value="${x.id}">${x.texto}</option>`);
                    $('#cbx_Origen').html(htmlO);

                    let htmlM = '';
                    res.monedas.forEach(x => htmlM += `<option value="${x.id}">${x.texto}</option>`);
                    $('#cbx_Moneda').html(htmlM);
            });

            // Cargar cuentas en caché para usarlas en las filas
            $.get('/Contabilidad/GetCuentas', function(res) {
                CUENTAS_CACHE = res;
                agregarLinea();
                agregarLinea();
            });
        });

        function agregarLinea() {
            CONTADOR_FILAS++;
            let idFila = CONTADOR_FILAS;

            let opts = '<option value="0">-- Buscar Cuenta --</option>';
            CUENTAS_CACHE.forEach(c => opts += `<option value="${c.id}">${c.codigo} - ${c.nombre}</option>`);

            let tr = `
            <tr id="tr_linea_${idFila}">
                <td class="text-left">
                    <select class="form-control select2-cuenta" id="cuenta_${idFila}">
                        ${opts}
                    </select>
                </td>
                <td><input type="text" class="form-control input-glosa-detalle" placeholder="Opcional"></td>
                <td><input type="number" class="form-control text-right input-debe" value="0.00" step="0.01" min="0" onchange="calcularCuadre()"></td>
                <td><input type="number" class="form-control text-right input-haber" value="0.00" step="0.01" min="0" onchange="calcularCuadre()"></td>
                <td><button class="btn btn-sm btn-outline-danger" onclick="removerLinea(${idFila})"><i class="fas fa-trash"></i></button></td>
            </tr>`;

            $('#tbl_Body').append(tr);
            $(`#cuenta_${idFila}`).select2({ theme: 'bootstrap4' });
        }

        function removerLinea(idFila) {
            $(`#tr_linea_${idFila}`).remove();
            calcularCuadre();
        }

        function calcularCuadre() {
            let totalDebe = 0;
            let totalHaber = 0;

            $('.input-debe').each(function() { totalDebe += (parseFloat($(this).val()) || 0); });
            $('.input-haber').each(function() { totalHaber += (parseFloat($(this).val()) || 0); });

            $('#txt_TotalDebe').val(totalDebe.toFixed(2));
            $('#txt_TotalHaber').val(totalHaber.toFixed(2));

            if(totalDebe > 0 && totalHaber > 0 && Math.abs(totalDebe - totalHaber) < 0.01) {
                $('#lbl_Cuadre').html('<i class="fas fa-check-circle"></i> OK').removeClass('text-danger').addClass('text-success');
                $('#txt_TotalDebe, #txt_TotalHaber').removeClass('border-danger text-danger').addClass('border-success text-success');
            } else {
                $('#lbl_Cuadre').html('<i class="fas fa-times-circle"></i> X').removeClass('text-success').addClass('text-danger');
                $('#txt_TotalDebe, #txt_TotalHaber').removeClass('border-success text-success').addClass('border-danger text-danger');
            }
        }

        function abrirModalProvisiones() {
            $('#efec-cargando').removeClass('d-none');
            $.get('/Contabilidad/GetProvisionesPendientes', function(res) {
                $('#efec-cargando').addClass('d-none');
                if(res.status) {
                    let html = '';
                    if(res.data.length > 0) {
                        res.data.forEach(x => {
                            html += `<tr>
                                <td><button class="btn btn-sm btn-success" onclick="jalarBorrador(${x.id})"><i class="fas fa-check"></i> Jalar</button></td>
                                <td class="text-left small">${x.proveedor}</td>
                                <td class="font-weight-bold">${x.documento}</td>
                                <td>${x.fecha}</td>
                                <td class="font-weight-bold text-primary">${x.total.toFixed(2)}</td>
                            </tr>`;
                        });
                    } else {
                        html = '<tr><td colspan="5" class="text-muted p-4">No hay facturas pendientes.</td></tr>';
                    }
                    $('#tbodyProvisiones').html(html);
                    $('#modalProvisiones').modal('show');
                }
            });
        }

        function abrirModalVentas() {
            $('#efec-cargando').removeClass('d-none');
            $.get('/Contabilidad/GetVentasPendientes', function(res) {
                $('#efec-cargando').addClass('d-none');
                if(res.status) {
                    let html = '';
                    if(res.data.length > 0) {
                        res.data.forEach(x => {
                            html += `<tr>
                                <td><button class="btn btn-sm btn-info" onclick="jalarBorradorVenta(${x.id})"><i class="fas fa-check"></i> Contabilizar</button></td>
                                <td class="text-left small font-weight-bold">${x.cliente}</td>
                                <td class="font-weight-bold">${x.documento}</td>
                                <td>${x.fecha}</td>
                                <td class="font-weight-bold text-success">${x.total.toFixed(2)}</td>
                            </tr>`;
                        });
                    } else {
                        html = '<tr><td colspan="5" class="text-muted p-4">No hay facturas de venta pendientes.</td></tr>';
                    }
                    $('#tbodyVentas').html(html);
                    $('#modalVentas').modal('show');
                }
            });
        }

        function jalarBorrador(id) {
            $('#modalProvisiones').modal('hide');
            $('#efec-cargando').removeClass('d-none');
            $.get('/Contabilidad/GenerarBorradorDocumentoPagar?documentoPagarId=' + id, function(res) {
                procesarRespuestaBorrador(res, 'documento_pagar');
            });
        }

        function jalarBorradorVenta(id) {
            $('#modalVentas').modal('hide');
            $('#efec-cargando').removeClass('d-none');
            $.get('/Contabilidad/GenerarBorradorDocumentoCobrar?documentoCobrarId=' + id, function(res) {
                procesarRespuestaBorrador(res, 'documento_cobrar');
            });
        }

        function procesarRespuestaBorrador(res, tablaRef) {
            $('#efec-cargando').addClass('d-none');
            if(res.status) {
                let d = res.data;

                $('#txt_FechaContable').val(d.fechaContable.split('T')[0]);
                $('#txt_Glosa').val(d.glosa);
                $('#cbx_Origen').val(d.origenAsientoId).trigger('change');

                if ($('#hdn_IdReferencia').length === 0) {
                    $('#hdn_EmpresaId').after(`<input type="hidden" id="hdn_IdReferencia" value="${d.idReferencia}">`);
                    $('#hdn_EmpresaId').after(`<input type="hidden" id="hdn_TablaReferencia" value="${tablaRef}">`);
                } else {
                    $('#hdn_IdReferencia').val(d.idReferencia);
                    $('#hdn_TablaReferencia').val(tablaRef);
                }

                $('#tbl_Body').empty();
                CONTADOR_FILAS = 0;

                d.detalles.forEach(det => {
                    agregarLinea();
                    let ultimaFila = CONTADOR_FILAS;
                    if(det.cuentaContableId > 0) {
                        $(`#cuenta_${ultimaFila}`).val(det.cuentaContableId).trigger('change');
                    }
                    $(`#tr_linea_${ultimaFila} .input-debe`).val(det.debeSoles.toFixed(2));
                    $(`#tr_linea_${ultimaFila} .input-haber`).val(det.haberSoles.toFixed(2));
                    $(`#tr_linea_${ultimaFila} .input-glosa-detalle`).val(det.glosaDetalle);
                });

                calcularCuadre();
                toastr.success("Borrador cargado. Complete las cuentas faltantes.");
            } else {
                toastr.error(res.message);
            }
        }

        function guardarAsiento() {
            // USAMOS EL PERIODOMANAGER GLOBAL EN LUGAR DEL COMBO
            let idPeriodo = PeriodoManager ? PeriodoManager.getActual() : null;

            if(!idPeriodo) return toastr.warning("No hay un Periodo Contable activo definido.");
            if(!$('#cbx_Origen').val()) return toastr.warning("Seleccione Origen.");
            if(!$('#txt_FechaContable').val()) return toastr.warning("Ingrese fecha.");
            if(!$('#cbx_Moneda').val()) return toastr.warning("Seleccione Moneda.");
            if(!$('#txt_Glosa').val().trim()) return toastr.warning("Ingrese una glosa general.");

            let totalDebe = parseFloat($('#txt_TotalDebe').val());
            let totalHaber = parseFloat($('#txt_TotalHaber').val());

            if(totalDebe === 0 || totalHaber === 0) return toastr.error("El asiento no tiene montos.");
            if(Math.abs(totalDebe - totalHaber) >= 0.01) return Swal.fire("Error", "El asiento está descuadrado.", "error");

            let detalles = [];
            let hayError = false;

            $('#tbl_Body tr').each(function() {
                let idSelect = $(this).find('.select2-cuenta').attr('id');
                let cuentaId = $(`#${idSelect}`).val();
                let glosaDet = $(this).find('.input-glosa-detalle').val();
                let debe = parseFloat($(this).find('.input-debe').val()) || 0;
                let haber = parseFloat($(this).find('.input-haber').val()) || 0;

                if (cuentaId == "0" && (debe > 0 || haber > 0)) {
                    hayError = true;
                    $(this).addClass('bg-danger text-white');
                } else {
                    $(this).removeClass('bg-danger text-white');
                    if (debe > 0 || haber > 0) {
                        detalles.push({
                            CuentaContableId: parseInt(cuentaId),
                            GlosaDetalle: glosaDet || $('#txt_Glosa').val(),
                            DebeSoles: debe,
                            HaberSoles: haber,
                            DebeDolares: 0,
                            HaberDolares: 0
                        });
                    }
                }
            });

            if (hayError) return toastr.error("Faltan asignar cuentas contables en algunas líneas.");
            if (detalles.length < 2) return toastr.error("Un asiento debe tener al menos 2 cuentas (partida doble).");

            let cabecera = {
                PeriodoId: parseInt(idPeriodo),
                OrigenAsientoId: parseInt($('#cbx_Origen').val()),
                FechaContable: $('#txt_FechaContable').val(),
                MonedaId: parseInt($('#cbx_Moneda').val()),
                Glosa: $('#txt_Glosa').val(),
                Detalles: detalles,
                IdReferencia: $('#hdn_IdReferencia').val() ? parseInt($('#hdn_IdReferencia').val()) : null,
                TablaReferencia: $('#hdn_TablaReferencia').val() ? $('#hdn_TablaReferencia').val() : null
            };

            Swal.fire({
                title: "¿Guardar Asiento Contable?",
                icon: "question",
                showCancelButton: true,
                confirmButtonText: "Sí, guardar"
            }).then((result) => {
                if (result.isConfirmed) {
                    $('#efec-cargando').removeClass('d-none');
                    $.ajax({
                        url: '/Contabilidad/GuardarAsiento',
                        type: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify(cabecera),
                        success: function(res) {
                            $('#efec-cargando').addClass('d-none');
                            if(res.status) {
                                Swal.fire("Éxito", res.message, "success").then(() => location.reload());
                            } else {
                                Swal.fire("Error", res.message, "error");
                            }
                        }
                    });
                }
            });
        }
    </script>
}