@{
    ViewData["Title"] = "Aplicación de Anticipos (Ventas)";
}

<style>
    /* Corrección de color para selección */
    .cls-monto-pend {
        color: #dc3545;
        font-weight: bold;
        font-size: 1.1em;
    }

    .bg-warning .cls-monto-pend {
        color: #212529 !important;
    }

    .cls-monto-disp {
        color: #28a745;
        font-weight: bold;
        font-size: 1.1em;
    }

    .bg-success .cls-monto-disp {
        color: #ffffff !important;
    }
</style>

<div class="card d-none" id="efec-cargando">
    <div class="position-fixed top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center overlay dark" style="z-index: 9999; background: rgba(0,0,0,0.5);">
        <i class="fas fa-3x fa-sync-alt fa-spin text-white"></i>
    </div>
</div>

<div class="container-fluid py-3">
    <div class="card shadow mb-3 border-left-info">
        <div class="card-body py-2">
            <div class="row align-items-center">
                <div class="col-md-2">
                    <label class="font-weight-bold m-0 text-info"><i class="fas fa-search"></i> Buscar Cliente:</label>
                </div>
                <div class="col-md-8">
                    <select id="cbx_Cliente" class="form-control w-100"></select>
                </div>
                <div class="col-md-2">
                    <button class="btn btn-info btn-block font-weight-bold" onclick="cargarDocumentos()">
                        <i class="fas fa-sync-alt"></i> Actualizar
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-5">
            <div class="card shadow mb-4">
                <div class="card-header bg-warning text-dark py-2">
                    <h6 class="m-0 font-weight-bold">1. Facturas / Boletas por Cobrar</h6>
                </div>
                <div class="card-body p-0" style="max-height: 400px; overflow-y: auto;">
                    <table class="table table-hover table-sm text-center mb-0" id="tbl_Pendientes">
                        <thead class="thead-light">
                            <tr>
                                <th>Doc</th>
                                <th>Fecha</th>
                                <th>Nro. Pedido</th>
                                <th class="text-right pr-3">Saldo</th>
                            </tr>
                        </thead>
                        <tbody><tr><td colspan="4" class="text-muted py-4">Seleccione un cliente arriba.</td></tr></tbody>
                    </table>
                </div>
            </div>

            <div class="card shadow border-left-dark">
                <div class="card-header bg-light py-2 d-flex justify-content-between">
                    <h6 class="m-0 font-weight-bold text-dark">Historial del Documento</h6>
                    <span class="badge badge-dark" id="lbl_DocSeleccionado">---</span>
                </div>
                <div class="card-body p-2" style="min-height: 150px;">
                    <ul class="list-unstyled small" id="tbl_Historial">
                        <li class="text-muted text-center py-3">Haga clic en una factura para ver.</li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-md-2 text-center align-self-center">
            <div class="card shadow border-primary">
                <div class="card-body p-3">
                    <label class="font-weight-bold text-primary mb-1">Monto a Aplicar</label>
                    <input type="number" id="txt_MontoAplicar" class="form-control text-center font-weight-bold form-control-lg text-primary border-primary mb-3" step="0.01">
                    <button class="btn btn-primary btn-block font-weight-bold shadow" onclick="ejecutarCruce()">
                        <i class="fas fa-exchange-alt"></i> APLICAR<br>ANTICIPO
                    </button>
                </div>
            </div>
        </div>

        <div class="col-md-5">
            <div class="card shadow h-100">
                <div class="card-header bg-success text-white py-2">
                    <h6 class="m-0 font-weight-bold">2. Anticipos Disponibles (A Favor)</h6>
                </div>
                <div class="card-body p-0" style="max-height: 550px; overflow-y: auto;">
                    <table class="table table-hover table-sm text-center mb-0" id="tbl_Disponibles">
                        <thead class="thead-light">
                            <tr>
                                <th>Doc</th>
                                <th>Fecha</th>
                                <th>Nro. Pedido</th>
                                <th class="text-right pr-3">A Favor</th>
                            </tr>
                        </thead>
                        <tbody><tr><td colspan="4" class="text-muted py-4">Seleccione un cliente arriba.</td></tr></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        let g_idCargo = 0, g_saldoCargo = 0;
        let g_idAbono = 0, g_saldoAbono = 0;

        $(document).ready(function() {
            // Cargar combo de clientes
            $.ajax({
                url: '/OrdenPedido/GetCombosRegistro',
                type: 'GET',
                success: function (data) {
                    if(data.status){
                        const clientesTrans = data.clientes.map(x => ({
                            id: x.id, text: `${x.tipoDocumentoIdentidad} ${x.numeroDocumento} - ${x.razonSocial}`
                        }));
                        $('#cbx_Cliente').select2({ theme: 'bootstrap4', placeholder: "Buscar Cliente", data: clientesTrans });
                        $('#cbx_Cliente').val(null).trigger('change');
                    }
                }
            });

            $('#cbx_Cliente').on('change', function() { cargarDocumentos(); });
        });

        function cargarDocumentos() {
            let cli = $('#cbx_Cliente').val();
            if(!cli) return resetSeleccion();

            $('#efec-cargando').removeClass('d-none');
            resetSeleccion();

            $.get('/CuentasPorCobrar/GetDocumentosParaAplicacion?clienteId=' + cli, function(res) {
                $('#efec-cargando').addClass('d-none');
                if(res.status) {
                    let htmlPend = res.pendientes.map(x => `<tr onclick="seleccionarCargo(${x.id}, ${x.saldoActual}, '${x.documento}', this)" style="cursor:pointer">
                        <td class="font-weight-bold text-dark">${x.documento}</td>
                        <td>${x.fecha}</td>
                        <td><small>${x.ordenNumero}</small></td>
                        <td class="text-right pr-3 cls-monto-pend">${x.saldoActual.toFixed(2)}</td>
                    </tr>`).join('') || '<tr><td colspan="4" class="text-muted py-3">No hay facturas pendientes.</td></tr>';
                    $('#tbl_Pendientes tbody').html(htmlPend);

                    let htmlDisp = res.disponibles.map(x => `<tr onclick="seleccionarAbono(${x.id}, ${x.saldo}, this)" style="cursor:pointer">
                        <td class="font-weight-bold text-dark">${x.documento}</td>
                        <td>${x.fecha}</td>
                        <td><small>${x.ordenNumero}</small></td>
                        <td class="text-right pr-3 cls-monto-disp">${x.saldo.toFixed(2)}</td>
                    </tr>`).join('') || '<tr><td colspan="4" class="text-muted py-3">No hay anticipos disponibles.</td></tr>';
                    $('#tbl_Disponibles tbody').html(htmlDisp);
                } else toastr.error("Error al cargar la data");
            });
        }

        function seleccionarCargo(id, saldo, docName, fila) {
            g_idCargo = id; g_saldoCargo = saldo;
            $('#tbl_Pendientes tr').removeClass('bg-warning');
            $(fila).addClass('bg-warning');

            $('#lbl_DocSeleccionado').text(docName);
            $('#tbl_Historial').html('<li class="text-center"><i class="fas fa-spinner fa-spin"></i></li>');

            $.get('/CuentasPorCobrar/GetHistorialDocumento?documentoId=' + id, function(res) {
                if(res.status && res.data.length > 0) {
                    let h = res.data.map(x => `<li class="mb-2 pb-1 border-bottom border-light">
                        <div class="d-flex justify-content-between">
                            <strong>${x.concepto}</strong> <span class="badge badge-light">${x.fecha}</span>
                        </div>
                        <div class="d-flex justify-content-between mt-1">
                            <small class="text-muted">${x.doc}</small>
                            <strong class="${x.color}">${x.monto}</strong>
                        </div>
                    </li>`).join('');
                    $('#tbl_Historial').html(h);
                } else $('#tbl_Historial').html('<li class="text-muted text-center py-2">Sin historial de aplicaciones</li>');
            });
            sugerirMonto();
        }

        function seleccionarAbono(id, saldo, fila) {
            g_idAbono = id; g_saldoAbono = saldo;
            $('#tbl_Disponibles tr').removeClass('bg-success text-white');
            $(fila).addClass('bg-success text-white');
            sugerirMonto();
        }

        function sugerirMonto() {
            if(g_idCargo > 0 && g_idAbono > 0) {
                $('#txt_MontoAplicar').val(Math.min(g_saldoCargo, g_saldoAbono).toFixed(2));
            }
        }

        function ejecutarCruce() {
            if(g_idCargo === 0 || g_idAbono === 0) return toastr.warning("Falta seleccionar documentos.");
            let monto = parseFloat($('#txt_MontoAplicar').val());
            if(!monto || monto <= 0) return toastr.error("Monto inválido.");
            if(monto > g_saldoCargo) return Swal.fire("Error", "Excede saldo pendiente de la factura.", "error");
            if(monto > g_saldoAbono) return Swal.fire("Error", "Excede saldo disponible del anticipo.", "error");

            Swal.fire({
                title: "¿Aplicar?",
                text: `Se descontarán ${monto.toFixed(2)} del anticipo.`,
                icon: "question",
                showCancelButton: true,
                reverseButtons: true,
                confirmButtonColor: "#3085d6",
                cancelButtonColor: "#d33",
                cancelButtonText: "Cancelar",
                confirmButtonText: "Sí, Aplicar"
            }).then((result) => {
                if (result.isConfirmed) {
                    $('#efec-cargando').removeClass('d-none');
                    $.post('/CuentasPorCobrar/GuardarAplicacion', {
                        idCargo: g_idCargo, idAbono: g_idAbono, montoAplicar: monto
                    }, function(res) {
                        $('#efec-cargando').addClass('d-none');
                        if(res.status) { Swal.fire("¡Aplicado!", res.message, "success"); cargarDocumentos(); }
                        else Swal.fire("Error", res.message, "error");
                    });
                }
            });
        }

        function resetSeleccion() {
            g_idCargo = 0; g_idAbono = 0; g_saldoCargo = 0; g_saldoAbono = 0;
            $('#lbl_DocSeleccionado').text('---'); $('#tbl_Historial').empty(); $('#txt_MontoAplicar').val('');
        }
    </script>
}