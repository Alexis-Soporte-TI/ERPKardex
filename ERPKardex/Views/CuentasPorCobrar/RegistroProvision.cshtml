@{
    ViewData["Title"] = "Registro de Facturación";
}

<div class="card d-none" id="efec-cargando">
    <div class="position-fixed top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center overlay dark" style="z-index: 9999; background: rgba(0,0,0,0.5);">
        <i class="fas fa-3x fa-sync-alt fa-spin text-white"></i>
    </div>
</div>

<div class="container-fluid py-3">
    <div class="row justify-content-center">
        <div class="col-lg-12">
            <div class="card shadow mb-4 border-left-dark">
                <div class="card-header bg-dark text-white d-flex justify-content-between">
                    <h5 class="m-0 font-weight-bold"><i class="fas fa-file-invoice"></i> Emitir Factura / Boleta (Ventas)</h5>
                </div>

                <div class="card-body">
                    <div class="row mb-3 p-3 bg-light rounded border mx-1">
                        <div class="col-12 mb-2"><label class="font-weight-bold text-dark">1. Seleccionar Pedido Origen</label></div>
                        <div class="col-md-12">
                            <div class="input-group">
                                <input type="text" id="txt_OrdenSeleccionada" class="form-control font-weight-bold bg-white" readonly placeholder="Haga clic para buscar pedido..." onclick="abrirModalBusqueda()">
                                <div class="input-group-append">
                                    <button class="btn btn-dark" type="button" onclick="abrirModalBusqueda()">
                                        <i class="fas fa-search"></i> BUSCAR PEDIDO PENDIENTE
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="small text-muted font-weight-bold">Cliente</label>
                            <input type="text" id="txt_ClienteDisplay" class="form-control bg-light text-primary font-weight-bold" readonly>
                            <input type="hidden" id="hdn_ClienteId">
                            <input type="hidden" id="hdn_OrdenId">
                            <input type="hidden" id="hdn_MonedaId">
                        </div>
                        <div class="col-md-3">
                            <label class="small text-muted font-weight-bold">Periodo Contable (*)</label>
                            <select id="cbx_Periodo" class="form-control select2"></select>
                        </div>
                        <div class="col-md-3">
                            <label class="small text-muted font-weight-bold">Condición de Pago original</label>
                            <input type="text" id="txt_CondicionPago" class="form-control bg-light" readonly>
                        </div>
                    </div>

                    <hr />

                    <div class="row mb-3">
                        <div class="col-md-3">
                            <label class="font-weight-bold">Tipo Comprobante (*)</label>
                            <select id="cbx_TipoDocumento" class="form-control border-dark text-dark font-weight-bold">
                                <option value="FAC">FACTURA ELECTRÓNICA</option>
                                <option value="BOL">BOLETA DE VENTA</option>
                                <option value="REC">RECIBO / TICKET</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="font-weight-bold">Serie y Número (*)</label>
                            <div class="input-group">
                                <input type="text" id="txt_Serie" class="form-control text-center text-uppercase" placeholder="F001" maxlength="4">
                                <input type="text" id="txt_Numero" class="form-control text-center" placeholder="0000123" maxlength="10">
                            </div>
                        </div>
                        <div class="col-md-3">
                            <label class="font-weight-bold">Fecha de Emisión (*)</label>
                            <input type="date" id="txt_FechaEmision" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" onchange="calcularVencimiento(); buscarTCDia();">
                        </div>
                        <div class="col-md-3">
                            <label class="font-weight-bold text-danger">Fecha de Vencimiento</label>
                            <input type="date" id="txt_FechaVencimiento" class="form-control border-danger text-danger">
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-3">
                            <label class="small font-weight-bold text-muted">Tipo de Cambio del Día</label>
                            <input type="text" id="txt_TC" class="form-control bg-light font-weight-bold text-center" readonly>
                        </div>
                        <div class="col-md-9">
                            <label class="small font-weight-bold text-muted">Observación</label>
                            <input type="text" id="txt_Observacion" class="form-control" placeholder="Alguna anotación para el comprobante...">
                        </div>
                    </div>
                </div>
            </div>

            <div class="card shadow mb-5">
                <div class="card-header bg-secondary text-white py-2 d-flex justify-content-between align-items-center">
                    <h6 class="m-0">Detalle a Facturar</h6>
                    <div class="custom-control custom-switch">
                        <input type="checkbox" class="custom-control-input" id="chk_IgvIncluido" checked onchange="recalcularTotal()">
                        <label class="custom-control-label font-weight-bold" for="chk_IgvIncluido" style="cursor:pointer">Precios Incluyen IGV</label>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-bordered table-striped text-center mb-0" id="tbl_DetalleFactura">
                            <thead class="thead-dark small">
                                <tr>
                                    <th width="5%">Ítem</th>
                                    <th width="40%" class="text-left">Descripción de Producto</th>
                                    <th width="10%">U.M.</th>
                                    <th width="15%">Cant. a Facturar</th>
                                    <th width="15%">Precio Unit.</th>
                                    <th width="15%">Importe</th>
                                </tr>
                            </thead>
                            <tbody id="tbl_DetalleBody">
                                <tr><td colspan="6" class="text-muted py-5 small">Seleccione un pedido...</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="card-footer bg-white">
                    <div class="row justify-content-end">
                        <div class="col-md-4">
                            <table class="table table-sm table-borderless mb-0">
                                <tr><td class="text-right font-weight-bold text-muted">SUB TOTAL:</td><td width="40%"><input type="text" id="txt_SubTotalFact" class="form-control text-right font-weight-bold bg-light" readonly value="0.00"></td></tr>
                                <tr><td class="text-right font-weight-bold text-muted">IGV (18%):</td><td><input type="text" id="txt_IgvFact" class="form-control text-right font-weight-bold bg-light" readonly value="0.00"></td></tr>
                                <tr><td class="text-right font-weight-bold h5 text-dark">TOTAL FACTURADO:</td><td><input type="text" id="txt_TotalFact" class="form-control border-dark text-dark text-right font-weight-bold h5 mb-0" readonly value="0.00"></td></tr>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <div class="text-right mb-5 pb-3">
                <a href="/CuentasPorCobrar/IndexProvisiones" class="btn btn-secondary btn-lg mr-2"><i class="fas fa-times"></i> Cancelar</a>
                <button class="btn btn-dark btn-lg font-weight-bold shadow" onclick="guardarFactura()"><i class="fas fa-save"></i> GUARDAR COMPROBANTE</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalOrdenes" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title font-weight-bold">Buscar Pedido para Facturar</h5>
                <button type="button" class="close text-white" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <div class="modal-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-striped mb-0 text-center">
                        <thead class="bg-light">
                            <tr>
                                <th>Número</th>
                                <th>Fecha</th>
                                <th>Cliente</th>
                                <th>Moneda</th>
                                <th>Total</th>
                                <th>Acción</th>
                            </tr>
                        </thead>
                        <tbody id="tbl_Ordenes"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        let DETALLES_ACTUALES = [];

        $(document).ready(function() {
            // Cargar combo periodos
            $.get('/Maestros/GetPeriodosContablesSelect2', function(data) {
                $('#cbx_Periodo').select2({ theme: 'bootstrap4', data: data.items });
                if(PeriodoManager && PeriodoManager.getActual()) {
                    $('#cbx_Periodo').val(PeriodoManager.getActual()).trigger('change');
                }
            });
            buscarTCDia();
        });

        function abrirModalBusqueda() {
            $('#modalOrdenes').modal('show');
            $('#tbl_Ordenes').html('<tr><td colspan="6" class="text-center py-3"><i class="fas fa-spinner fa-spin"></i> Buscando...</td></tr>');

            // Ya no pasamos "tipoOrigen" porque siempre es OrdenPedido
            $.get('/CuentasPorCobrar/BuscarOrdenesPendientes', function(res) {
                let html = '';
                if(res.status && res.data.length > 0) {
                    res.data.forEach(x => {
                        html += `<tr>
                            <td class="font-weight-bold">${x.numero}</td>
                            <td>${x.fecha}</td>
                            <td><small>${x.tipoDocumentoIdentidad}: ${x.numeroDocumento}</small><br>${x.cliente}</td>
                            <td class="font-weight-bold">${x.monedaNombre}</td>
                            <td class="text-right text-primary font-weight-bold">${x.totalOrden.toFixed(2)}</td>
                            <td>
                                <button class="btn btn-sm btn-dark" onclick="seleccionarOrden(${x.id}, '${x.numero}', '${x.cliente.replace(/'/g, "\\'")}', ${x.clienteId})">ELEGIR</button>
                            </td>
                        </tr>`;
                    });
                } else {
                    html = '<tr><td colspan="6" class="text-center text-muted py-3">No hay pedidos pendientes de facturar.</td></tr>';
                }
                $('#tbl_Ordenes').html(html);
            });
        }

        function seleccionarOrden(id, num, cliNombre, cliId) {
            $('#txt_OrdenSeleccionada').val(num);
            $('#txt_ClienteDisplay').val(cliNombre);
            $('#hdn_OrdenId').val(id);
            $('#hdn_ClienteId').val(cliId);
            $('#modalOrdenes').modal('hide');

            $('#efec-cargando').removeClass('d-none');

            $.get(`/CuentasPorCobrar/GetDetallesOrden?ordenId=${id}`, function(res) {
                $('#efec-cargando').addClass('d-none');
                if(res.status) {
                    $('#txt_CondicionPago').val(res.cabecera.condicionPago);
                    $('#hdn_MonedaId').val(res.cabecera.monedaId);
                    calcularVencimiento();

                    DETALLES_ACTUALES = res.data.map(d => ({
                        IdReferencia: d.id, // Mapeado para que GuardarProvision sepa de qué DOrdenPedido viene
                        Item: d.item,
                        Descripcion: d.producto,
                        UnidadMedida: d.unidadMedida,
                        CantidadPendiente: d.saldo, // Lo que falta facturar
                        CantidadFacturar: d.saldo, // Por defecto facturamos todo
                        PrecioUnitario: d.precioUnitario,
                        Total: d.saldo * d.precioUnitario
                    }));
                    pintarGrilla();
                } else {
                    toastr.error("Error al traer detalles.");
                }
            });
        }

        function pintarGrilla() {
            let html = '';
            DETALLES_ACTUALES.forEach(x => {
                html += `<tr>
                    <td class="align-middle">${x.Item}</td>
                    <td class="align-middle text-left font-weight-bold small text-dark">${x.Descripcion}</td>
                    <td class="align-middle">${x.UnidadMedida}</td>
                    <td>
                        <input type="number" class="form-control text-center font-weight-bold border-primary text-primary"
                               value="${x.CantidadFacturar}" step="0.01" min="0" max="${x.CantidadPendiente}"
                               onchange="actualizarLinea('${x.IdReferencia}', 'cant', this.value)">
                        <small class="text-muted d-block mt-1">Máx: ${x.CantidadPendiente}</small>
                    </td>
                    <td>
                        <input type="number" class="form-control text-right"
                               value="${x.PrecioUnitario.toFixed(2)}" step="0.01" min="0.01"
                               onchange="actualizarLinea('${x.IdReferencia}', 'precio', this.value)">
                    </td>
                    <td class="align-middle font-weight-bold" id="td_imp_${x.IdReferencia}">${x.Total.toFixed(2)}</td>
                </tr>`;
            });
            $('#tbl_DetalleBody').html(html);
            recalcularTotal();
        }

        function actualizarLinea(idRef, tipo, valor) {
            let num = parseFloat(valor) || 0;
            let det = DETALLES_ACTUALES.find(x => x.IdReferencia == idRef);
            if(det) {
                if(tipo === 'cant') {
                    if(num > det.CantidadPendiente) {
                        toastr.warning("No puede facturar más cantidad de la que indica el pedido.");
                        num = det.CantidadPendiente;
                    }
                    det.CantidadFacturar = num;
                } else if(tipo === 'precio') {
                    det.PrecioUnitario = num;
                }
                det.Total = det.CantidadFacturar * det.PrecioUnitario;
                pintarGrilla(); // Repintamos para forzar validaciones visuales
            }
        }

        function recalcularTotal() {
            let sumatoriaBase = 0;
            DETALLES_ACTUALES.forEach(x => sumatoriaBase += x.Total);

            let incluyeIgv = $('#chk_IgvIncluido').is(':checked');
            let subtotal = 0, igv = 0, total = 0;

            if(sumatoriaBase > 0) {
                if(incluyeIgv) {
                    subtotal = sumatoriaBase / 1.18;
                    igv = sumatoriaBase - subtotal;
                    total = sumatoriaBase;
                } else {
                    subtotal = sumatoriaBase;
                    igv = subtotal * 0.18;
                    total = subtotal + igv;
                }
            }

            $('#txt_SubTotalFact').val(subtotal.toFixed(2));
            $('#txt_IgvFact').val(igv.toFixed(2));
            $('#txt_TotalFact').val(total.toFixed(2));
        }

        function calcularVencimiento() {
            let condicion = $('#txt_CondicionPago').val() || '';
            let fechaEmi = new Date($('#txt_FechaEmision').val());
            let dias = 0;

            if(condicion.includes("15")) dias = 15;
            else if(condicion.includes("30")) dias = 30;
            else if(condicion.includes("45")) dias = 45;
            else if(condicion.includes("60")) dias = 60;

            fechaEmi.setDate(fechaEmi.getDate() + dias);
            $('#txt_FechaVencimiento').val(fechaEmi.toISOString().split('T')[0]);
        }

        function buscarTCDia() {
            $.get('/TipoCambio/GetTcPorFecha?fecha=' + $('#txt_FechaEmision').val(), function(res) {
                if(res.status) $('#txt_TC').val(res.valor.toFixed(3)); // res.valor idealmente tcVenta
                else $('#txt_TC').val('0.000');
            });
        }

        function guardarFactura() {
            if(!$('#hdn_OrdenId').val()) return toastr.warning("Seleccione un pedido a facturar.");
            if(!$('#txt_Serie').val() || !$('#txt_Numero').val()) return toastr.warning("Ingrese serie y número.");
            if(!$('#cbx_Periodo').val()) return toastr.warning("Seleccione periodo contable.");

            let tc = parseFloat($('#txt_TC').val());
            if(isNaN(tc) || tc <= 0) return toastr.warning("Tipo de cambio inválido. Verifique la fecha.");

            let detallesFiltrados = DETALLES_ACTUALES.filter(x => x.CantidadFacturar > 0);
            if(detallesFiltrados.length === 0) return toastr.warning("Debe facturar al menos un ítem con cantidad mayor a cero.");

            let incluyeIgv = $('#chk_IgvIncluido').is(':checked');

            let documento = {
                ClienteId: $('#hdn_ClienteId').val(),
                OrdenPedidoId: $('#hdn_OrdenId').val(),
                MonedaId: $('#hdn_MonedaId').val(),
                PeriodoContableId: $('#cbx_Periodo').val(),
                Serie: $('#txt_Serie').val().toUpperCase(),
                Numero: $('#txt_Numero').val(),
                FechaEmision: $('#txt_FechaEmision').val(),
                FechaVencimiento: $('#txt_FechaVencimiento').val(),
                TipoCambio: tc,
                SubTotal: parseFloat($('#txt_SubTotalFact').val()),
                MontoIgv: parseFloat($('#txt_IgvFact').val()),
                Total: parseFloat($('#txt_TotalFact').val()),
                Observacion: $('#txt_Observacion').val()
            };

            // Estructuramos detalle como pide el controlador
            let detalles = detallesFiltrados.map(x => ({
                IdReferencia: x.IdReferencia, // Aquí va el ID del detalle del pedido (DOrdenPedido)
                Cantidad: x.CantidadFacturar,
                PrecioUnitario: incluyeIgv ? (x.PrecioUnitario / 1.18) : x.PrecioUnitario,
                Total: x.Total
            }));

            Swal.fire({
                title: "¿Emitir Comprobante?",
                text: `Vence el: ${documento.FechaVencimiento}`,
                icon: "question",
                showCancelButton: true,
                confirmButtonColor: "#3085d6",
                cancelButtonColor: "#d33",
                reverseButtons: true,
                cancelButtonText: "Cancelar",
                confirmButtonText: "Sí, Registrar"
            }).then((result) => {
                if (result.isConfirmed) {
                    $('#efec-cargando').removeClass('d-none');
                    $.ajax({
                        url: '/CuentasPorCobrar/GuardarProvision',
                        type: 'POST',
                        data: {
                            doc: documento,
                            codigoTipoDoc: $('#cbx_TipoDocumento').val(),
                            detallesJson: JSON.stringify(detalles)
                        },
                        success: function(res) {
                            $('#efec-cargando').addClass('d-none');
                            if(res.status) Swal.fire("Registrado", res.message, "success").then(() => location.href = '/CuentasPorCobrar/IndexProvisiones');
                            else Swal.fire("Error", res.message, "error");
                        },
                        error: function() { $('#efec-cargando').addClass('d-none'); toastr.error("Error servidor."); }
                    });
                }
            });
        }

        function limpiar() {
            // Limpia en caso de cancelar o reiniciar
            $('#txt_OrdenSeleccionada, #txt_ClienteDisplay, #txt_CondicionPago').val('');
            $('#hdn_OrdenId, #hdn_ClienteId').val('');
            DETALLES_ACTUALES = [];
            pintarGrilla();
        }
    </script>
}